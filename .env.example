# GitHub Adapter
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scope: repo (for private repos) or public_repo (for public only)
GITHUB_TOKEN=
GITHUB_REPO=owner/repository

# Cursor Adapter (Cloud)
CURSOR_API_KEY=
CURSOR_REPOSITORY=owner/repository
CURSOR_DEFAULT_REF=main
CURSOR_AUTO_CREATE_PR=false

# Cursor Adapter (Local - development only)
LOCAL_CURSOR_SERVER_URL=http://localhost:3847

# Jira Adapter
# Create an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Hosted homepage showcase (all values are server-only)
SHOWCASE_ENABLED=true
OPENAI_API_KEY=
SHOWCASE_MODEL=gpt-5-nano
QUICKCHAT_KV_REST_API_URL=
QUICKCHAT_KV_REST_API_TOKEN=
# Required aggregate reserved-token ceiling. Select for the deployment's budget.
SHOWCASE_DAILY_TOKEN_BUDGET=
# Dedicated public demo repository, NOT the product source repository.
# Pre-create its issues/src branch; restrict token to Issues + Contents write there.
SHOWCASE_GITHUB_REPO=
SHOWCASE_GITHUB_TOKEN=
